pipeline {
    agent any

    environment {
        IMAGE_NAME = 'docvol'
        IMAGE_TAG  = "${BUILD_NUMBER}"
        CONTAINER_NAME = 'docvol-app-prod'
    }

    stages {
        stage('Code Checkout') {
            steps {
                echo '=== Step 1: Checking out source code ==='
                checkout scm
            }
        }

        stage('Code Quality & Test') {
            steps {
                echo '=== Step 2: Validating project files ==='
                dir('docker_volume') {
                    sh '''
                        echo "Checking project files and structure..."
                        test -f server.js && echo "server.js exists"
                        test -f package.json && echo "package.json exists"
                        test -f Dockerfile && echo "Dockerfile exists"
                        ls -la
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo "=== Step 3: Building Docker Image ${IMAGE_NAME}:${IMAGE_TAG} ==="
                dir('docker_volume') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest .
                    """
                }
            }
        }

        stage('Deploy Application Stack') {
            steps {
                echo "=== Step 4: Deploying full stack (MongoDB + App) ==="
                sh """
                    # 1. Create a dedicated bridge network if not already present
                    docker network create docvol-net || true

                    # 2. Start MongoDB container if not running
                    if ! docker ps --format '{{.Names}}' | grep -q '^mongodb\$'; then
                        echo "Starting MongoDB container..."
                        docker rm -f mongodb || true
                        docker run -d \\
                            --name mongodb \\
                            --network docvol-net \\
                            -p 27017:27017 \\
                            -e MONGO_INITDB_ROOT_USERNAME=admin \\
                            -e MONGO_INITDB_ROOT_PASSWORD=password \\
                            --restart always \\
                            mongo:latest
                    else
                        echo "MongoDB container is already running."
                    fi

                    # 3. Deploy updated App container
                    echo "Deploying ${CONTAINER_NAME} with image ${IMAGE_NAME}:${IMAGE_TAG}..."
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d \\
                        --name ${CONTAINER_NAME} \\
                        --network docvol-net \\
                        -p 3002:3000 \\
                        -e PORT=3000 \\
                        -e MONGO_URL=mongodb://admin:password@mongodb:27017/devops_db?authSource=admin \\
                        -e UPLOAD_DIR=/app/uploads \\
                        --restart unless-stopped \\
                        ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Health Check') {
            steps {
                echo "=== Step 5: Verifying container stack health ==="
                sh """
                    sleep 6
                    docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}" | grep -E "${CONTAINER_NAME}|mongodb"
                    echo "Checking if App is responding..."
                    docker exec ${CONTAINER_NAME} wget -qO- http://localhost:3000/api/health || true
                    echo ""
                    echo "Application is live and connected to MongoDB on port 3002!"
                """
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished execution.'
        }
        success {
            echo "CI/CD Pipeline passed successfully! App deployed at http://localhost:3002 🎉"
        }
        failure {
            echo 'Pipeline failed. Check build logs. ❌'
        }
    }
}
