FROM node:20-alpine

# Set working directory (creates folder automatically)
WORKDIR /home/app

# Copy dependency manifests first for optimal Docker layer caching
COPY package*.json ./

# Install only production dependencies cleanly
RUN npm ci --omit=dev

# Copy the rest of the application code
COPY . .

# Expose app port
EXPOSE 3000

# Run as non-root user (built into node alpine images) for security
USER node

# Start the server
CMD ["node", "server.js"]
